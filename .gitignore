# ==========================================
*.usd
*.USD
*.usda
*.usdc
*.usd.backup
*.zip
*.stl
*.dae
*.mdl

# 테스트 실행 시 생성되는 결과 이미지/동영상
*.png
*.jpg

# Isaac Sim collected world assets (large binaries, 100MB+ files) - keep out of repo
/isaacpjt/*
!/isaacpjt/M0609/
/isaacpjt/M0609/*
!/isaacpjt/M0609/assembly_nut_fraction1.py
!/isaacpjt/M0609/error_fix_depth1.py
!/isaacpjt/M0609/plot_yaw_align_log.py
/src/Collected_World0123/

# 궤적 녹화 스크립트 실행 로그 (재현 시 매번 새로 생성됨, 로컬 절대경로 포함)
src/arm_node/scripts/record_result.txt
src/arm_node/scripts/record_stdout.log

